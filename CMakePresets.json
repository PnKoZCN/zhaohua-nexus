{
  "version": 3,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host (Linux/macOS) with tests",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ZH_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a",
      "binaryDir": "${sourceDir}/build_android",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{NDK}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "CMAKE_BUILD_TYPE": "Release",
        "ZH_STRICT": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "host", "configurePreset": "host" },
    { "name": "android-arm64", "configurePreset": "android-arm64" }
  ]
}
